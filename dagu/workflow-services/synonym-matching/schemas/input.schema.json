{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "synonym-matching inventory pair input V2",
  "type": "object",
  "required": ["studentInventory", "referenceInventory"],
  "additionalProperties": false,
  "properties": {
    "studentInventory": {"$ref": "#/definitions/inventoryEnvelope"},
    "referenceInventory": {"$ref": "#/definitions/inventoryEnvelope"},
    "comparisonConfig": {
      "type": "object",
      "properties": {"semantics": {"type": "object", "maxProperties": 0}}
    }
  },
  "definitions": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "required": ["key", "role", "label", "modelId", "versionId"],
      "properties": {
        "key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$"},
        "role": {"enum": ["submission", "reference"]},
        "label": {"type": "string", "minLength": 1},
        "modelId": {"type": "string", "minLength": 1},
        "versionId": {"type": "string", "minLength": 1}
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "type", "comparisonGroup", "language", "matchText", "labelStatus", "textLanguage"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": ["string", "null"]},
        "comparisonGroup": {"type": ["string", "null"]},
        "language": {"oneOf": [
          {"type": "null"},
          {"type": "object", "required": ["languageId", "versionId"], "properties": {
            "languageId": {"type": "string", "minLength": 1},
            "versionId": {"type": "string", "minLength": 1}
          }}
        ]},
        "matchText": {"type": "string"},
        "labelStatus": {"enum": ["present", "missing", "unsupported"]},
        "textLanguage": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "connectionText": {
      "type": "object",
      "required": ["id", "ownerConnectionId", "kind", "connectionLabelId", "matchText", "labelStatus", "textLanguage"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "ownerConnectionId": {"type": ["string", "null"], "minLength": 1},
        "kind": {"enum": ["self", "additionalLabel"]},
        "connectionLabelId": {"type": ["string", "null"]},
        "matchText": {"type": "string"},
        "labelStatus": {"enum": ["present", "missing", "unsupported"]},
        "textLanguage": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "inventoryBody": {
      "type": "object",
      "required": ["schema", "evaluationId", "source", "inputHash", "graphHash", "graphPath", "inventoryHash", "producer", "elements", "connectionTexts", "completeness", "diagnostics"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "element-inventory/v2"},
        "evaluationId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$"},
        "source": {"$ref": "#/definitions/source"},
        "inputHash": {"$ref": "#/definitions/hash"},
        "graphHash": {"$ref": "#/definitions/hash"},
        "inventoryHash": {"$ref": "#/definitions/hash"},
        "graphPath": {"type": "string", "minLength": 1},
        "producer": {"type": "object"},
        "elements": {"type": "array", "items": {"$ref": "#/definitions/element"}},
        "connectionTexts": {"type": "array", "items": {"$ref": "#/definitions/connectionText"}},
        "completeness": {
          "type": "object", "required": ["interpretation"],
          "properties": {"interpretation": {"enum": ["complete", "partial"]}}
        },
        "diagnostics": {"type": "array", "items": {"type": "object"}}
      }
    },
    "inventoryEnvelope": {
      "type": "object",
      "required": ["schema", "schemaVersion", "status", "capability", "result"],
      "properties": {
        "schema": {"const": "workflow-result/v1"},
        "schemaVersion": {"const": 1, "type": "integer"},
        "status": {"const": "ok"},
        "capability": {"const": "model-label-extraction"},
        "result": {"$ref": "#/definitions/inventoryBody"}
      }
    }
  }
}
