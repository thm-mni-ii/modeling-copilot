{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "synonym-matching output v0.2",
  "type": "object",
  "required": [
    "status",
    "capability",
    "step",
    "summary",
    "result"
  ],
  "properties": {
    "status": {
      "const": "ok"
    },
    "capability": {
      "const": "synonym-matching"
    },
    "step": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "result": {
      "type": "object",
      "required": [
        "referenceElements",
        "studentElements",
        "shape",
        "scores",
        "combinedScores",
        "synonymMatrix",
        "processedLabels",
        "config",
        "threshold",
        "metadata"
      ],
      "properties": {
        "referenceElements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "label": {
                "type": "string"
              },
              "language": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "studentElements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "label": {
                "type": "string"
              },
              "language": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "scores": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            }
          }
        },
        "combinedScores": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          }
        },
        "synonymMatrix": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "referenceElement",
              "matches",
              "top1Top2Margin"
            ],
            "properties": {
              "referenceElement": {
                "type": "object",
                "required": [
                  "id",
                  "label"
                ],
                "properties": {
                  "id": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "label": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              },
              "matches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "submissionElement",
                    "scores",
                    "combinedScore",
                    "rank",
                    "mutualBest"
                  ],
                  "properties": {
                    "submissionElement": {
                      "type": "object",
                      "required": [
                        "id",
                        "label"
                      ],
                      "properties": {
                        "id": {
                          "oneOf": [
                            {
                              "type": "string",
                              "minLength": 1
                            },
                            {
                              "type": "integer"
                            }
                          ]
                        },
                        "label": {
                          "type": "string"
                        },
                        "language": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": true
                    },
                    "scores": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      }
                    },
                    "combinedScore": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "rank": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "mutualBest": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "top1Top2Margin": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "processedLabels": {
          "type": "object"
        },
        "config": {
          "type": "object"
        },
        "threshold": {
          "type": [
            "number",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  },
  "additionalProperties": false
}
