{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "semantic-candidates/v2 in workflow-result/v1",
  "type": "object",
  "required": ["schema", "schemaVersion", "status", "capability", "mode", "summary", "result"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "workflow-result/v1"},
    "schemaVersion": {"const": 1, "type": "integer"},
    "status": {"const": "ok"},
    "capability": {"const": "synonym-matching"},
    "mode": {"const": "match"},
    "summary": {"type": "string"},
    "result": {
      "type": "object",
      "required": ["schema", "evaluationId", "inputHash", "pair", "graphHashes", "inventoryHashes", "inventoryPaths", "semanticConfig", "semanticConfigHash", "producer", "methods", "combiner", "threshold", "filtered", "candidatePairCount", "scoredPairCount", "unavailablePairCount", "connectionTextPairCount", "processedTexts", "synonymMatrix", "connectionTextMatrix", "unscoredElements", "completeness", "diagnostics", "candidateHash"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "semantic-candidates/v2"},
        "evaluationId": {"type": "string"},
        "inputHash": {"$ref": "#/definitions/hash"},
        "candidateHash": {"$ref": "#/definitions/hash"},
        "semanticConfigHash": {"$ref": "#/definitions/hash"},
        "pair": {
          "type": "object", "required": ["studentKey", "referenceKey"],
          "properties": {"studentKey": {"const": "submission"}, "referenceKey": {"type": "string"}}
        },
        "graphHashes": {"$ref": "#/definitions/pairHashes"},
        "inventoryHashes": {"$ref": "#/definitions/pairHashes"},
        "inventoryPaths": {
          "type": "object", "required": ["student", "reference"],
          "properties": {
            "student": {"type": "string", "pattern": "^labels/[A-Za-z0-9_-]{1,100}\\.json$"},
            "reference": {"type": "string", "pattern": "^labels/[A-Za-z0-9_-]{1,100}\\.json$"}
          }
        },
        "semanticConfig": {"type": "object", "required": ["engine", "resources", "methods", "combiner", "threshold", "filtered", "producer"]},
        "producer": {"type": "object", "required": ["service", "version", "resourceHash", "runtime", "packages"]},
        "methods": {"type": "array", "items": {"type": "object", "required": ["name", "rawScoreRange", "combinationContributionRange", "contributesToCombination"]}},
        "combiner": {"type": "object", "required": ["kind", "name", "options", "methods", "contributingMethods", "contributionTransform", "formula", "scoreRange", "scoreMeaning"]},
        "threshold": {"type": "null"},
        "filtered": {"const": false},
        "candidatePairCount": {"type": "integer", "minimum": 0},
        "scoredPairCount": {"type": "integer", "minimum": 0},
        "unavailablePairCount": {"type": "integer", "minimum": 0},
        "connectionTextPairCount": {"type": "integer", "minimum": 0},
        "processedTexts": {
          "type": "object", "required": ["student", "reference"],
          "additionalProperties": false,
          "properties": {
            "student": {"$ref": "#/definitions/processedTextList"},
            "reference": {"$ref": "#/definitions/processedTextList"}
          }
        },
        "synonymMatrix": {"type": "array", "items": {
          "type": "object", "required": ["referenceElementId", "matches"],
          "additionalProperties": false,
          "properties": {
            "referenceElementId": {"type": "string", "minLength": 1},
            "matches": {"type": "array", "items": {"$ref": "#/definitions/elementCandidate"}}
          }
        }},
        "connectionTextMatrix": {"type": "array", "items": {
          "type": "object", "required": ["referenceConnectionTextId", "matches"],
          "additionalProperties": false,
          "properties": {
            "referenceConnectionTextId": {"type": "string", "minLength": 1},
            "matches": {"type": "array", "items": {"$ref": "#/definitions/connectionTextCandidate"}}
          }
        }},
        "unscoredElements": {"type": "array", "items": {
          "type": "object", "required": ["side", "id", "reason"],
          "properties": {
            "side": {"enum": ["student", "reference"]},
            "id": {"type": "string"},
            "reason": {"enum": ["missing_text", "unsupported_text"]}
          }
        }},
        "completeness": {
          "type": "object", "required": ["technical", "interpretation"],
          "properties": {"technical": {"const": "complete"}, "interpretation": {"enum": ["complete", "partial"]}}
        },
        "diagnostics": {"type": "array", "items": {"type": "object"}}
      }
    }
  },
  "definitions": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unitScore": {"type": "number", "minimum": 0, "maximum": 1},
    "pairHashes": {
      "type": "object", "required": ["student", "reference"],
      "properties": {
        "student": {"$ref": "#/definitions/hash"},
        "reference": {"$ref": "#/definitions/hash"}
      }
    },
    "processedTextList": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "text"], "additionalProperties": false,
        "properties": {"id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}}
      }
    },
    "scores": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/definitions/scoresScored"}
      ]
    },
    "elementCandidate": {
      "type": "object",
      "required": ["submissionElementId", "comparisonBasis", "scoreStatus", "scores", "combinedScore", "aliasEvidence"],
      "additionalProperties": false,
      "properties": {
        "submissionElementId": {"type": "string", "minLength": 1},
        "comparisonBasis": {"enum": ["group", "type"]},
        "scoreStatus": {"enum": ["scored", "unavailable"]},
        "scores": {"$ref": "#/definitions/scores"},
        "combinedScore": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/unitScore"}]},
        "aliasEvidence": {"type": "array", "maxItems": 0}
      },
      "allOf": [
        {"if": {"properties": {"scoreStatus": {"const": "scored"}}},
         "then": {"properties": {"scores": {"$ref": "#/definitions/scoresScored"}, "combinedScore": {"$ref": "#/definitions/unitScore"}}},
         "else": {"properties": {"scores": {"type": "null"}, "combinedScore": {"type": "null"}}}}
      ]
    },
    "scoresScored": {
      "type": "object", "required": ["levenshtein", "jaro_winkler", "char_trigram", "multilingual"],
      "additionalProperties": false,
      "properties": {
        "levenshtein": {"$ref": "#/definitions/unitScore"},
        "jaro_winkler": {"$ref": "#/definitions/unitScore"},
        "char_trigram": {"$ref": "#/definitions/unitScore"},
        "multilingual": {"type": "number", "minimum": -1, "maximum": 1}
      }
    },
    "connectionTextCandidate": {
      "type": "object",
      "required": ["submissionConnectionTextId", "referenceOwnerConnectionId", "submissionOwnerConnectionId", "kind", "connectionLabelId", "scoreStatus", "scores", "combinedScore", "unavailableReason"],
      "additionalProperties": false,
      "properties": {
        "submissionConnectionTextId": {"type": "string", "minLength": 1},
        "referenceOwnerConnectionId": {"type": ["string", "null"]},
        "submissionOwnerConnectionId": {"type": ["string", "null"]},
        "kind": {"enum": ["self", "additionalLabel"]},
        "connectionLabelId": {"type": ["string", "null"]},
        "scoreStatus": {"const": "unavailable"},
        "scores": {"type": "null"},
        "combinedScore": {"type": "null"},
        "unavailableReason": {"enum": ["missing_text", "unsupported_text", "connection_owner_compatibility_not_in_inventory"]}
      }
    }
  }
}
