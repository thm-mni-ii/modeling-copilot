{
  "seed": 42,
  "threshold": 0.5,
  "languages": ["de", "en"],
  "strategies": ["threshold", "mutual_best", "hungarian"],
  "preprocessing": {
    "raw": [],
    "normalize": ["normalize"],
    "lowercase": ["normalize", "lowercase"],
    "lemma": ["normalize", "lemmatize", "lowercase"],
    "stem": ["normalize", "lowercase", "stem"],
    "identifiers": ["normalize", "split_identifiers", "lowercase"],
    "identifiers_cased": ["normalize", "split_identifiers"],
    "compounds_cased": ["normalize", "split_compounds"],
    "identifiers_lemma": ["normalize", "split_identifiers", "lemmatize", "lowercase"],
    "compounds_lemma": ["normalize", "split_compounds", "lemmatize", "lowercase"],
    "all_light": ["normalize", "split_identifiers", "split_compounds", "lemmatize", "lowercase"],
    "stopwords": ["normalize", "lowercase", "remove_stopwords"],
    "compounds": ["normalize", "lowercase", "split_compounds"]
  },
  "methods": {
    "levenshtein": {"ablate": true},
    "damerau_levenshtein": {"ablate": true},
    "jaro_winkler": {"ablate": true},
    "char_bigram": {"ablate": true},
    "char_trigram": {"ablate": true},
    "token_jaccard": {"ablate": true},
    "token_sort_ratio": {"ablate": true},
    "word_order": {"ablate": true},
    "exact_match": {},
    "multilingual": {},
    "translated_embedding": {"languages": ["de", "en"]},
    "translated_string": {"languages": ["de", "en"]},
    "wordnet": {"languages": ["de", "en"]},
    "openthesaurus": {"languages": ["de"]},
    "word2vec_de_matching": {
      "files": {"de": ".cache/word-vectors/word2vec-de/german.model"},
      "format": "word2vec_binary",
      "translate_to_en": false,
      "ablate": true,
      "lowercase": false,
      "nouns_only": false,
      "delta": 0.2,
      "model": "GermanWordEmbeddings, Wikipedia/News 2013, 300D",
      "source": "https://huggingface.co/Word2vec/german_model",
      "revision": "1dfd63ac969f4d0fe5b76eeb20534aa8617d791f",
      "license": "MIT according to Hugging Face model card"
    },
    "fasttext_de_matching": {
      "files": {"de": ".cache/word-vectors/fasttext-de/model.bin"},
      "format": "fasttext_bin",
      "translate_to_en": false,
      "ablate": true,
      "lowercase": true,
      "nouns_only": false,
      "delta": 0.2,
      "model": "facebook/fasttext-de-vectors, full binary with subwords",
      "source": "https://huggingface.co/facebook/fasttext-de-vectors",
      "revision": "2fdd228795139196371a78578790c8191282e25a",
      "license": "CC BY-SA 3.0"
    },
    "fasttext_en_matching": {
      "files": {"en": ".cache/word-vectors/fasttext-en/model.bin"},
      "format": "fasttext_bin",
      "translate_to_en": true,
      "ablate": true,
      "lowercase": true,
      "nouns_only": false,
      "delta": 0.2,
      "model": "facebook/fasttext-en-vectors, full binary with subwords",
      "source": "https://huggingface.co/facebook/fasttext-en-vectors",
      "revision": "a80392390daaee1a91000da45c376d512e1dc555",
      "license": "CC BY-SA 3.0"
    }
  },
  "combinations": [
    {"name": "string_ensemble", "variant": "string_ensemble"},
    {"name": "token_ensemble", "variant": "token_ensemble"},
    {"name": "character_token_ensemble", "variant": "character_token_ensemble"},
    {"name": "embedding_ensemble", "variant": "embedding_ensemble"},
    {"name": "string_translation_embedding", "variant": "string_translation_embedding"},
    {"name": "string_both_embeddings", "variant": "string_both_embeddings"},
    {"name": "maximum_fusion", "variant": "maximum_fusion"},
    {"name": "geometric_fusion", "variant": "geometric_fusion"},
    {"name": "exact_match_fusion", "variant": "exact_match_fusion"},
    {"name": "context_aware", "variant": "context_aware"},
    {"name": "string_multi_75_25", "variant": "weighted_fusion", "options": {"embedding_weight": 0.25}},
    {"name": "string_multi_50_50", "variant": "weighted_fusion", "options": {"embedding_weight": 0.5}},
    {"name": "string_multi_25_75", "variant": "weighted_fusion", "options": {"embedding_weight": 0.75}},
    {"name": "wordnet_string",
     "weights": {"wordnet": 3, "levenshtein": 1, "jaro_winkler": 1, "char_trigram": 1}},
    {"name": "openthesaurus_string",
     "weights": {"openthesaurus": 3, "levenshtein": 1, "jaro_winkler": 1, "char_trigram": 1}},
    {"name": "wordnet_multilingual", "weights": {"wordnet": 1, "multilingual": 1}},
    {"name": "openthesaurus_multilingual", "weights": {"openthesaurus": 1, "multilingual": 1}},
    {"name": "wordnet_openthesaurus", "weights": {"wordnet": 1, "openthesaurus": 1}},
    {"name": "fasttext_de_levenshtein", "weights": {"fasttext_de_matching": 1, "levenshtein": 1}},
    {"name": "fasttext_en_levenshtein", "weights": {"fasttext_en_matching": 1, "levenshtein": 1}},
    {"name": "string_embedding_global_ranking", "variant": "weighted_fusion",
     "options": {"embedding_weight": 0.5}, "global_ranking": true}
  ]
}
