{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Synonym matrix output",
  "type": "object",
  "required": [
    "synonymMatrix"
  ],
  "properties": {
    "synonymMatrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "referenceElement",
          "matches"
        ],
        "properties": {
          "referenceElement": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "label": {
                "type": "string"
              },
              "language": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "submissionElement",
                "scores",
                "combinedScore"
              ],
              "properties": {
                "submissionElement": {
                  "type": "object",
                  "required": [
                    "id",
                    "label"
                  ],
                  "properties": {
                    "id": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "integer"
                        }
                      ]
                    },
                    "label": {
                      "type": "string"
                    },
                    "language": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                },
                "scores": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  }
                },
                "combinedScore": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
