{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Standalone synonym research input (not semantic-candidates/v1)",
  "type": "object",
  "required": [
    "input"
  ],
  "properties": {
    "step": {
      "const": "synonym_matching"
    },
    "input": {
      "type": "object",
      "required": [
        "referenceModel",
        "studentModel"
      ],
      "properties": {
        "referenceModel": {
          "type": "object",
          "required": [
            "elements"
          ],
          "properties": {
            "elements": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": [
                      "id",
                      "label"
                    ],
                    "properties": {
                      "id": {
                        "oneOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "integer"
                          }
                        ]
                      },
                      "label": {
                        "type": "string"
                      },
                      "language": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": true
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "studentModel": {
          "type": "object",
          "required": [
            "elements"
          ],
          "properties": {
            "elements": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": [
                      "id",
                      "label"
                    ],
                    "properties": {
                      "id": {
                        "oneOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "integer"
                          }
                        ]
                      },
                      "label": {
                        "type": "string"
                      },
                      "language": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": true
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "embedding_model": {
              "enum": [
                "jina_de",
                "multilingual",
                "e5_base"
              ]
            },
            "lexicon_mode": {
              "enum": [
                "odenet",
                "odenet_first",
                "odenet_linked"
              ]
            },
            "spelling_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "meaning_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "exact_first": {
              "type": "boolean"
            },
            "lexicon_path": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
