{
  "seed": 42,
  "threshold": 0.5,
  "languages": ["de", "en"],
  "strategies": ["threshold", "mutual_best", "hungarian"],
  "preprocessing": {
    "raw": [],
    "normalize": ["normalize"],
    "lowercase": ["normalize", "lowercase"],
    "lemma": ["normalize", "lemmatize", "lowercase"],
    "stem": ["normalize", "lowercase", "stem"],
    "identifiers": ["normalize", "split_identifiers", "lowercase"],
    "identifiers_cased": ["normalize", "split_identifiers"],
    "compounds": ["normalize", "lowercase", "split_compounds"],
    "compounds_cased": ["normalize", "split_compounds"],
    "stopwords": ["normalize", "lowercase", "remove_stopwords"],
    "lemma_cased": ["normalize", "lemmatize"]
  },
  "methods": {
    "levenshtein": {},
    "damerau_levenshtein": {},
    "jaro_winkler": {},
    "char_bigram": {},
    "char_trigram": {},
    "token_jaccard": {},
    "token_sort_ratio": {},
    "word_order": {},
    "exact_match": {},
    "multilingual": {},
    "translated_embedding": {"languages": ["de", "en"]},
    "translated_string": {"languages": ["de", "en"]},
    "wn_translation": {"languages": ["de", "en"]},
    "wordnet": {
      "languages": ["de", "en"],
      "relation_features": ["pair_known", "reference_synset_count", "student_synset_count", "reference_hypernym", "reference_hyponym", "antonym", "path_similarity", "wup_similarity", "taxonomy_available"]
    },
    "openthesaurus": {"languages": ["de"]},
    "word2vec_de_matching": {
      "files": {"de": ".cache/word-vectors/word2vec-de/german.model"},
      "format": "word2vec_binary",
      "lowercase": false,
      "nouns_only": false,
      "delta": 0.2,
      "model": "GermanWordEmbeddings, Wikipedia/News 2013, 300D",
      "source": "https://huggingface.co/Word2vec/german_model",
      "revision": "1dfd63ac969f4d0fe5b76eeb20534aa8617d791f",
      "license": "MIT according to Hugging Face model card",
      "preprocessing_steps": ["normalize", "lowercase", "split_identifiers", "split_compounds", "lemmatize"]
    },
    "fasttext_de_matching": {
      "files": {"de": ".cache/word-vectors/fasttext-de/model.bin"},
      "format": "fasttext_bin",
      "lowercase": false,
      "nouns_only": false,
      "delta": 0.2,
      "model": "facebook/fasttext-de-vectors, full binary with subwords",
      "source": "https://huggingface.co/facebook/fasttext-de-vectors",
      "revision": "2fdd228795139196371a78578790c8191282e25a",
      "license": "CC BY-SA 3.0",
      "preprocessing_steps": ["normalize", "lowercase", "split_identifiers", "split_compounds", "lemmatize"]
    },
    "fasttext_en_matching": {
      "files": {"en": ".cache/word-vectors/fasttext-en/model.bin"},
      "format": "fasttext_bin",
      "lowercase": false,
      "nouns_only": false,
      "delta": 0.2,
      "model": "facebook/fasttext-en-vectors, full binary with subwords",
      "source": "https://huggingface.co/facebook/fasttext-en-vectors",
      "revision": "a80392390daaee1a91000da45c376d512e1dc555",
      "license": "CC BY-SA 3.0",
      "preprocessing_steps": ["normalize", "lowercase", "split_identifiers", "split_compounds", "lemmatize"]
    },
    "word2vec_de_optimal_matching": {"based_on": "word2vec_de_matching", "matching": "optimal"},
    "word2vec_de_bidirectional_matching": {"based_on": "word2vec_de_matching", "matching": "bidirectional"},
    "fasttext_de_optimal_matching": {"based_on": "fasttext_de_matching", "matching": "optimal"},
    "fasttext_de_bidirectional_matching": {"based_on": "fasttext_de_matching", "matching": "bidirectional"},
    "fasttext_en_optimal_matching": {"based_on": "fasttext_en_matching", "matching": "optimal"},
    "fasttext_en_bidirectional_matching": {"based_on": "fasttext_en_matching", "matching": "bidirectional"},
    "odenet": {
      "languages": ["de"],
      "relation_features": ["pair_known", "reference_synset_count", "student_synset_count", "reference_hypernym", "reference_hyponym", "antonym", "path_similarity", "wup_similarity", "taxonomy_available"]
    }
  },
  "chains": {
    "lev": ["$pre", "levenshtein"],
    "dam": ["$pre", "damerau_levenshtein"],
    "jw": ["$pre", "jaro_winkler"],
    "bigram": ["$pre", "char_bigram"],
    "trigram": ["$pre", "char_trigram"],
    "jaccard": ["$pre", "token_jaccard"],
    "tsort": ["$pre", "token_sort_ratio"],
    "order": ["$pre", "word_order"],
    "exact": ["normalize", "exact_match"],
    "multi": ["normalize", "multilingual"],
    "trans_emb": ["normalize", "translated_embedding"],
    "trans_str": ["normalize", "translated_string"],
    "wordnet": ["normalize", "wordnet"],
    "wn_translate": ["normalize", "wn_translation"],
    "thesaurus": ["normalize", "openthesaurus"],
    "w2v_de": ["$pre", "word2vec_de_matching"],
    "ft_de": ["$pre", "fasttext_de_matching"],
    "ft_en": ["normalize", "translate", "fasttext_en_matching"],
    "w2v_de_opt": ["$pre", "word2vec_de_optimal_matching"],
    "w2v_de_bi": ["$pre", "word2vec_de_bidirectional_matching"],
    "ft_de_opt": ["$pre", "fasttext_de_optimal_matching"],
    "ft_de_bi": ["$pre", "fasttext_de_bidirectional_matching"],
    "ft_en_opt": ["normalize", "translate", "fasttext_en_optimal_matching"],
    "ft_en_bi": ["normalize", "translate", "fasttext_en_bidirectional_matching"],
    "lev_en": ["normalize", "translate", "levenshtein"],
    "jw_en": ["normalize", "translate", "jaro_winkler"],
    "trigram_en": ["normalize", "translate", "char_trigram"],
    "multi_en": ["normalize", "translate", "multilingual"],
    "lev_stem": ["normalize", "stem", "levenshtein"],
    "odenet": ["normalize", "odenet"],
    "odenet_lemma": ["normalize", "lemmatize", "odenet"],
    "thesaurus_lemma": ["normalize", "lemmatize", "openthesaurus"],
    "wordnet_lemma": ["normalize", "translate", "lemmatize", "wordnet"],
    "multi_lowercase": ["normalize", "lowercase", "multilingual"],
    "multi_lemma": ["normalize", "lemmatize", "multilingual"],
    "multi_identifiers": ["normalize", "split_identifiers", "multilingual"],
    "multi_compounds": ["normalize", "split_compounds", "multilingual"],
    "trans_emb_lowercase": ["normalize", "translate", "lowercase", "translated_embedding"],
    "trans_emb_lemma": ["normalize", "translate", "lemmatize", "translated_embedding"],
    "trans_emb_identifiers": ["normalize", "split_identifiers", "translated_embedding"],
    "trans_emb_compounds": ["normalize", "split_compounds", "translated_embedding"],
    "ft_en_lowercase": ["normalize", "translate", "lowercase", "fasttext_en_matching"],
    "ft_en_lemma": ["normalize", "translate", "lemmatize", "fasttext_en_matching"],
    "ft_en_identifiers": ["normalize", "split_identifiers", "translate", "fasttext_en_matching"],
    "ft_en_opt_lowercase": ["normalize", "translate", "lowercase", "fasttext_en_optimal_matching"],
    "ft_en_opt_lemma": ["normalize", "translate", "lemmatize", "fasttext_en_optimal_matching"],
    "ft_en_opt_identifiers": ["normalize", "split_identifiers", "translate", "fasttext_en_optimal_matching"],
    "ft_en_bi_lowercase": ["normalize", "translate", "lowercase", "fasttext_en_bidirectional_matching"],
    "ft_en_bi_lemma": ["normalize", "translate", "lemmatize", "fasttext_en_bidirectional_matching"],
    "ft_en_bi_identifiers": ["normalize", "split_identifiers", "translate", "fasttext_en_bidirectional_matching"]
  },
  "mixes": [
    {"name": "string_ensemble", "variant": "string_ensemble", "parts": ["lev", "jw", "trigram"]},
    {"name": "token_ensemble", "variant": "token_ensemble", "parts": ["jaccard", "tsort"]},
    {
      "name": "character_token_ensemble",
      "variant": "character_token_ensemble",
      "parts": ["lev", "jw", "trigram", "jaccard", "tsort"]
    },
    {"name": "embedding_ensemble", "variant": "embedding_ensemble", "parts": ["trans_emb", "multi"]},
    {
      "name": "string_translation_embedding",
      "variant": "string_translation_embedding",
      "parts": ["lev", "jw", "trigram", "trans_emb"]
    },
    {
      "name": "string_both_embeddings",
      "variant": "string_both_embeddings",
      "parts": ["lev", "jw", "trigram", "trans_emb", "multi"]
    },
    {"name": "maximum_fusion", "variant": "maximum_fusion", "parts": ["lev", "jw", "trigram", "multi"]},
    {"name": "geometric_fusion", "variant": "geometric_fusion", "parts": ["lev", "jw", "trigram", "multi"]},
    {"name": "exact_match_fusion", "variant": "exact_match_fusion", "parts": ["lev", "jw", "trigram", "multi", "exact"]},
    {"name": "context_aware", "variant": "context_aware", "parts": ["lev", "jw", "trigram", "multi"]},
    {
      "name": "string_multi_75_25",
      "variant": "weighted_fusion",
      "options": {"embedding_weight": 0.25},
      "parts": ["lev", "jw", "trigram", "multi"]
    },
    {
      "name": "string_multi_50_50",
      "variant": "weighted_fusion",
      "options": {"embedding_weight": 0.5},
      "parts": ["lev", "jw", "trigram", "multi"]
    },
    {
      "name": "string_multi_25_75",
      "variant": "weighted_fusion",
      "options": {"embedding_weight": 0.75},
      "parts": ["lev", "jw", "trigram", "multi"]
    },
    {
      "name": "string_embedding_global_ranking",
      "variant": "weighted_fusion",
      "options": {"embedding_weight": 0.5},
      "parts": ["lev", "jw", "trigram", "multi"],
      "global_ranking": true
    },
    {"name": "wordnet_string", "weights": {"wordnet": 3, "lev": 1, "jw": 1, "trigram": 1}},
    {"name": "openthesaurus_string", "weights": {"thesaurus": 3, "lev": 1, "jw": 1, "trigram": 1}},
    {"name": "wordnet_multilingual", "weights": {"wordnet": 1, "multi": 1}},
    {"name": "openthesaurus_multilingual", "weights": {"thesaurus": 1, "multi": 1}},
    {"name": "wordnet_openthesaurus", "weights": {"wordnet": 1, "thesaurus": 1}},
    {"name": "fasttext_de_levenshtein", "weights": {"ft_de": 1, "lev": 1}},
    {"name": "fasttext_en_levenshtein", "weights": {"ft_en": 1, "lev": 1}},
    {"name": "fasttext_order_embedding", "weights": {"ft_de": 1, "order": 1, "multi": 1}},
    {"name": "word2vec_order_embedding", "weights": {"w2v_de": 1, "order": 1, "multi": 1}},
    {"name": "fasttext_en_order_embedding", "weights": {"ft_en": 1, "order": 1, "multi": 1}},
    {"name": "fasttext_embedding_thesaurus", "weights": {"ft_de": 1, "multi": 1, "thesaurus": 1}},
    {"name": "fasttext_embedding_wordnet", "weights": {"ft_de": 1, "multi": 1, "wordnet": 1}},
    {"name": "consensus_fusion", "variant": "consensus_fusion", "parts": ["trans_emb", "multi"]},
    {"weights": {"lev_stem": 1, "multi": 3}},
    {"weights": {"jw_en": 1, "multi": 1}},
    {"name": "odenet_multi_25_75", "weights": {"odenet": 1, "multi": 3}},
    {"name": "odenet_multi_50_50", "weights": {"odenet": 2, "multi": 2}},
    {"name": "odenet_multi_75_25", "weights": {"odenet": 3, "multi": 1}},
    {"name": "odenet_lemma_multilingual", "weights": {"odenet_lemma": 1, "multi": 1}},
    {"name": "odenet_openthesaurus", "weights": {"odenet": 1, "thesaurus": 1}},
    {"name": "odenet_wordnet", "weights": {"odenet": 1, "wordnet": 1}},
    {"name": "odenet_thesaurus_multilingual", "weights": {"odenet": 1, "thesaurus": 1, "multi": 1}},
    {"name": "odenet_string", "weights": {"odenet": 3, "lev": 1, "jw": 1, "trigram": 1}},
    {"name": "wordnet_lemma_multilingual", "weights": {"wordnet_lemma": 1, "multi": 1}},
    {"name": "thesaurus_lemma_multilingual", "weights": {"thesaurus_lemma": 1, "multi": 1}}
  ]
}
