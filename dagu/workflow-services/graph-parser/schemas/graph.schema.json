{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Normalized modeling graph (draft v1)",
  "type": "object",
  "required": ["schemaVersion", "languages", "complete", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "complete": { "type": "boolean", "description": "False if error diagnostics exist; no automatic correction or reliable grading of incomplete graphs." },
    "languages": { "type": "array", "items": { "$ref": "#/definitions/language" } },
    "nodes": { "type": "array", "items": { "$ref": "#/definitions/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/definitions/edge" } }
  },
  "definitions": {
    "language": {
      "type": "object",
      "required": ["languageId", "versionId"],
      "additionalProperties": false,
      "properties": {
        "languageId": { "type": "string", "minLength": 1 },
        "versionId": { "type": "string", "minLength": 1 }
      }
    },
    "nullableLanguage": { "anyOf": [{ "$ref": "#/definitions/language" }, { "type": "null" }] },
    "properties": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/definitions/anchor" },
        "target": { "$ref": "#/definitions/anchor" }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pointId": { "type": "string" },
        "role": { "enum": ["input", "output", "bidirectional"] },
        "x": { "type": "string" },
        "y": { "type": "string" }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "kind", "type", "label", "language", "properties"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["element", "connection"] },
        "type": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "language": { "$ref": "#/definitions/nullableLanguage" },
        "properties": { "$ref": "#/definitions/properties" },
        "directed": { "type": ["boolean", "null"] }
      },
      "if": { "properties": { "kind": { "const": "connection" } } },
      "then": { "required": ["directed"] }
    },
    "edge": {
      "type": "object",
      "required": ["id", "kind", "type", "source", "target", "directed", "label", "language", "properties"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["contains", "connection", "endpoint"] },
        "type": { "type": "string", "minLength": 1 },
        "source": { "type": ["string", "null"] },
        "target": { "type": ["string", "null"] },
        "directed": { "type": ["boolean", "null"] },
        "label": { "type": "string" },
        "language": { "$ref": "#/definitions/nullableLanguage" },
        "properties": { "$ref": "#/definitions/properties" },
        "originId": { "type": "string", "minLength": 1 },
        "endpoints": { "$ref": "#/definitions/endpoints" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "contains" } } },
          "then": {
            "required": ["originId"],
            "properties": { "source": { "type": "string" }, "target": { "type": "string" }, "type": { "const": "contains" }, "directed": { "const": true } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "endpoint" } } },
          "then": { "required": ["originId", "endpoints"], "properties": { "type": { "enum": ["source", "target"] } } }
        },
        {
          "if": { "properties": { "kind": { "const": "connection" } } },
          "then": { "required": ["endpoints"] }
        }
      ]
    }
  }
}
